---
/**
 * @file Base HTML layout for the terminal-styled pages.
 * @module components/TerminalLayout
 */
import BaseHead from './BaseHead.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title       = 'prajan@portfolio - bash',
  description = 'Prajan Karthik — Full-stack engineer. CS undergrad building production systems.',
  noindex     = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <div class="terminal-container">
      <slot />
    </div>
  </body>
</html>
