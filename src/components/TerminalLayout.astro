---
/**
 * @file Base HTML layout with font preload and viewport meta for all terminal pages.
 * @module components/TerminalLayout
 */
interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'prajan@portfolio — bash',
  description = 'Prajan Karthik — Full-stack engineer. CS undergrad building production systems.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <!-- JetBrains Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="terminal-container">
      <slot />
    </div>
  </body>
</html>
