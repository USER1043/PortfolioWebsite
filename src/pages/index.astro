---
/**
 * @file Homepage — mounts the interactive terminal and boots the session engine.
 * @module pages/index
 */
import '../styles/global.css';
import '../styles/terminal.css';
import TerminalLayout from '../components/TerminalLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { getProjects } from '../lib/projects';

// Serialise project data for the client-side `projects` command.
// `<` is escaped so a value can never close the <script> tag early.
const projectsJson = JSON.stringify(await getProjects()).replace(/</g, '\\u003c');
---

<TerminalLayout title="prajan@portfolio — bash">
  <TerminalWindow username="prajan@portfolio" />
  <script type="application/json" id="projects-data" set:html={projectsJson} />
</TerminalLayout>

<script type="module">
  import { initTerminal } from '../lib/terminal.js';

  // Wire up the terminal engine once the DOM is ready.
  const outputEl        = document.getElementById('terminal-output');
  const inputEl         = document.getElementById('terminal-input');
  const bodyEl          = document.getElementById('terminal-body');
  const terminalWindowEl = document.getElementById('terminal-window');
  const sessionEndedEl  = document.getElementById('session-ended');
  const projects        = JSON.parse(document.getElementById('projects-data')?.textContent || '[]');

  if (outputEl && inputEl && bodyEl && terminalWindowEl && sessionEndedEl) {
    initTerminal({ outputEl, inputEl, bodyEl, terminalWindowEl, sessionEndedEl, projects });
  }
</script>
